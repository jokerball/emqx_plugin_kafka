%% -*- mode: erlang -*-
{deps, [
    {emqx_plugin_helper, {git, "https://github.com/emqx/emqx-plugin-helper.git", {tag, "v5.9.1"}}},
    {brod, {git, "https://github.com/kafka4beam/brod.git", {tag, "3.16.8"}}}
    
]}.

{plugins, [
    {emqx_plugrel, {git, "https://github.com/emqx/emqx_plugrel.git", {tag, "0.6.3"}}}
]}.

{project_plugins, [{erlfmt, "1.6.0"}]}.

{erl_opts, [debug_info]}.

%% Sync release version to app version in VERSION file.
%% app.src uses: {vsn, {file, "VERSION"}}.
{pre_hooks, [
    {"(linux|darwin)", compile,
        "erl -noshell -eval '{ok, Terms} = file:consult(\"rebar.config\"), "
        "{relx, Relx} = lists:keyfind(relx, 1, Terms), "
        "{release, {_, Vsn}, _} = lists:keyfind(release, 1, Relx), "
        "ok = file:write_file(\"VERSION\", [Vsn, $\\n]), "
        "halt().'"}
]}.

%% this is the plugin release version.
{relx, [
    {release, {emqx_plugin_kafka, "1.0.0"}, [
        emqx_plugin_kafka,
        emqx_plugin_helper,
        brod,
        kafka_protocol,
        crc32cer,
        supervisor3
    ]},
    {dev_mode, false},
    {include_erts, false},
    {include_src, false}
]}.

%% Additional info of the plugin
{emqx_plugrel, [
    {authors, ["Anonymous"]},
    {builder, [
        {name, "Anonymous"},
        {contact, "anonymous@example.org"},
        {website, "http://example.com"}
    ]},
    {repo, "https://github.com/emqx/emqx-plugin-template"},
    {functionality, ["Demo"]},
    {compatibility, [{emqx, "~> 5.7"}]},
    {description, "Another amazing EMQX plugin."}
]}.
